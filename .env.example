# -----------------------------------------------------------------------------
# Copia este archivo a ".env.local" y rellena los valores (sin comillas).
#   Windows / Mac:  cp .env.example .env.local
#   PowerShell:       Copy-Item .env.example .env.local
# -----------------------------------------------------------------------------
# Nunca subas .env.local a Git (ya está en .gitignore).
# -----------------------------------------------------------------------------

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_publica

# Solo servidor (panel /admin: listar y crear usuarios). Misma página API → service_role
# NO uses el prefijo NEXT_PUBLIC_ en esta clave.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_secreta

# Groq — recomendaciones en dashboard
GROQ_API_KEY=tu_groq_api_key

# Opcional: script "npm run seed:admin" (primer usuario ADMIN o actualizar ese email a ADMIN)
# BOOTSTRAP_ADMIN_EMAIL=admin@ejemplo.com
# BOOTSTRAP_ADMIN_PASSWORD=minimo_8_caracteres
